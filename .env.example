# ── Application ───────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-generate-32-random-bytes

# SQLite (default) or Postgres: postgresql://user:pass@host/rdns
DATABASE_URL=sqlite:///./rdns.db

# ── PowerDNS nodes ─────────────────────────────────────────────────────
# Amsterdam is ns1 (primary) — best IPv6 connectivity
# pdns_api_url = RESTKnot API base URL (default port 5000)
# pdns_api_key = X-API-Key set in RESTKnot api.yml on each node
AMS_IPV4=9.10.11.12
AMS_IPV6=2a0e:b107:2::53
AMS_PDNS_URL=http://10.0.2.1:5000
AMS_PDNS_KEY=your-ams-restknot-key

FRA_IPV4=1.2.3.4
FRA_IPV6=2a0e:b107::53
FRA_PDNS_URL=http://10.0.1.1:5000
FRA_PDNS_KEY=your-fra-restknot-key

DUS_IPV4=5.6.7.8
DUS_IPV6=2a0e:b107:1::53
DUS_PDNS_URL=http://10.0.0.1:5000
DUS_PDNS_KEY=your-dus-restknot-key

WAW_IPV4=13.14.15.16
WAW_IPV6=2a0e:b107:3::53
WAW_PDNS_URL=http://10.0.3.1:5000
WAW_PDNS_KEY=your-waw-restknot-key
